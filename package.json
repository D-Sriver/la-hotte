{
  "name": "la-hotte",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "db:local": "wrangler d1 execute la-hotte --local --file=schema.sql && wrangler d1 migrations apply la-hotte --local",
    "db:remote": "wrangler d1 execute la-hotte --remote --file=schema.sql && wrangler d1 migrations apply la-hotte --remote",
    "db:migrate": "wrangler d1 migrations apply la-hotte --remote",
    "db:migrate:local": "wrangler d1 migrations apply la-hotte --local",
    "db:reset:lists": "wrangler d1 execute la-hotte --remote --file=scripts/reset-lists.sql",
    "preview": "npm run build && wrangler pages dev",
    "deploy": "npm run build && wrangler pages deploy",
    "deploy:reminders": "wrangler deploy --config reminders/wrangler.toml",
    "setup:push": "node scripts/setup-push.mjs",
    "test": "node --test --test-reporter=spec \"tests/**/*.test.js\"",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@fontsource/onest": "5.3.1",
    "@fontsource/unbounded": "5.3.0",
    "@gsap/react": "^2.1.2",
    "gsap": "^3.13.0",
    "jose": "^5.9.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "9.39.5",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "vite": "^5.4.11",
    "wrangler": "^4.20.0"
  },
  "allowScripts": {
    "esbuild@0.21.5": true,
    "esbuild@0.28.2": true,
    "workerd@1.20261104.1": true
  }
}

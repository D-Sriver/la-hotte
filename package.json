{
  "name": "la-hotte",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "db:local": "wrangler d1 execute la-hotte --local --file=schema.sql",
    "db:remote": "wrangler d1 execute la-hotte --remote --file=schema.sql",
    "db:migrate:remote": "wrangler d1 execute la-hotte --remote --file=migrations/001_join_code.sql",
    "db:migrate:photo": "wrangler d1 execute la-hotte --remote --file=migrations/002_wish_photo.sql",
    "db:migrate:gifts": "wrangler d1 execute la-hotte --remote --file=migrations/003_group_bought_favorite.sql",
    "db:migrate:prices": "wrangler d1 execute la-hotte --remote --file=migrations/004_price_searches.sql",
    "db:migrate:amounts": "wrangler d1 execute la-hotte --remote --file=migrations/005_contribution_amount.sql",
    "db:migrate:families": "wrangler d1 execute la-hotte --remote --file=migrations/006_families.sql",
    "db:migrate:more": "wrangler d1 execute la-hotte --remote --file=migrations/008_more.sql",
    "db:migrate:push": "wrangler d1 execute la-hotte --remote --file=migrations/009_push.sql",
    "db:migrate:photos": "wrangler d1 execute la-hotte --remote --file=migrations/010_photos.sql",
    "db:reset:lists": "wrangler d1 execute la-hotte --remote --file=migrations/007_reset_lists.sql",
    "preview": "npm run build && wrangler pages dev",
    "deploy": "npm run build && wrangler pages deploy",
    "deploy:reminders": "wrangler deploy --config reminders/wrangler.toml",
    "setup:push": "node scripts/setup-push.mjs"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "gsap": "^3.13.0",
    "jose": "^5.9.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "vite": "^5.4.11",
    "wrangler": "^4.20.0"
  },
  "allowScripts": {
    "esbuild@0.21.5": true,
    "esbuild@0.28.2": true,
    "workerd@1.20261104.1": true
  }
}

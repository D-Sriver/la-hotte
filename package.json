{
  "name": "la-hotte",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "db:local": "wrangler d1 execute la-hotte --local --file=schema.sql",
    "db:remote": "wrangler d1 execute la-hotte --remote --file=schema.sql",
    "db:migrate:remote": "wrangler d1 execute la-hotte --remote --file=migrations/001_join_code.sql",
    "preview": "npm run build && wrangler pages dev",
    "deploy": "npm run build && wrangler pages deploy"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "gsap": "^3.13.0",
    "jose": "^5.9.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "vite": "^5.4.11",
    "wrangler": "^4.20.0"
  }
}
